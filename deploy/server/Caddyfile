# Caddy in front of the site. Installed as /etc/caddy/Caddyfile.
# The hostnames come from /etc/small-web/caddy.env:
#   NL_HOSTS      the public names (thenaturelibrary.org, www.…) once DNS points here
#   NL_STAGING    a test name, served with noindex
{
	servers {
		# Cloudflare sits in front once the zone moves; trust its ranges for the client address
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(nature_library) {
	encode zstd gzip

	# AI crawlers the Vercel firewall denied (managed rule ai_bots). Cloudflare's "Block AI bots" does
	# this at the edge once the zone is there; this is the second lock, for anything that reaches the origin.
	@ai_bots header_regexp User-Agent (?i)(GPTBot|ChatGPT-User|OAI-SearchBot|ClaudeBot|Claude-Web|anthropic-ai|CCBot|Bytespider|Amazonbot|PerplexityBot|Perplexity-User|meta-externalagent|meta-externalfetcher|FacebookBot|Google-CloudVertexBot|cohere-ai|cohere-training-data-crawler|Diffbot|ImagesiftBot|Omgilibot|Timpibot|YouBot|AI2Bot|Applebot-Extended|img2dataset|Scrapy)
	respond @ai_bots "Automated access is not allowed. See /robots.txt." 403

	# which commit is live (the deploy workflow and DEPLOY.md use it)
	handle /__version {
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "no-store"
		root * /srv/site/nature-library/current
		rewrite * /REVISION
		file_server
	}

	# Next's hashed build assets never change; let browsers and any CDN keep them
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	header -Server
	header X-Origin small-web

	reverse_proxy localhost:3000 {
		# a restart during a deploy takes a second or two: hold requests instead of failing them
		lb_try_duration 20s
		lb_try_interval 250ms
		# Next builds absolute redirects (the sign-in callback) from the address it listens on, not the
		# Host header: put the public name back
		header_down Location "^https?://localhost:3000" "https://{http.request.host}"
	}

	log {
		output file /var/log/caddy/nature-library.log {
			roll_size 100MiB
			roll_keep 10
			roll_keep_for 336h
		}
		format json
	}
}

{$NL_HOSTS:http://nl-hosts.invalid} {
	# Until DNS points here, Let's Encrypt cannot check these names, so Caddy falls back to its own certificate.
	# Cloudflare (SSL mode "Full") accepts it, so the DNS switch has no gap; Caddy gets a real certificate on its
	# next renewal (within hours), and Cloudflare can then be set to "Full (strict)".
	tls {
		issuer acme
		issuer internal
	}
	@www host www.thenaturelibrary.org
	redir @www https://thenaturelibrary.org{uri} 308
	import nature_library
}

{$NL_STAGING:http://nl-staging.invalid} {
	header X-Robots-Tag "noindex, nofollow"
	import nature_library
}
